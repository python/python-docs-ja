msgstr "``a + b`` ベクトル和"

#: ../../library/turtle.rst:2549
msgid "``a - b`` vector subtraction"
msgstr "``a - b`` ベクトル差"

#: ../../library/turtle.rst:2550
msgid "``a * b`` inner product"
msgstr "``a * b`` 内積"

#: ../../library/turtle.rst:2551
msgid "``k * a`` and ``a * k`` multiplication with scalar"
msgstr "``k * a`` および ``a * k`` スカラー倍"

#: ../../library/turtle.rst:2552
msgid "``abs(a)`` absolute value of a"
msgstr "``abs(a)`` a の絶対値"

#: ../../library/turtle.rst:2553
msgid "``a.rotate(angle)`` rotation"
msgstr "``a.rotate(angle)`` 回転"

#: ../../library/turtle.rst:2557
msgid "Exceptions"
msgstr "例外"

#: ../../library/turtle.rst:2559
msgid "The :mod:`!turtle` module defines the following exception:"
msgstr ""

