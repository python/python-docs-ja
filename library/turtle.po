msgstr "*t* ミリ秒後に *fun* を呼び出すタイマーを仕掛けます。"

#: ../../library/turtle.rst:2179
msgid ""
">>> running = True\n"
">>> def f():\n"
"...     if running:\n"
"...         fd(50)\n"
"...         lt(60)\n"
"...         screen.ontimer(f, 250)\n"
">>> f()   ### makes the turtle march around\n"
">>> running = False"
msgstr ""

