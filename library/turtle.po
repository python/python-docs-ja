#: ../../library/turtle.rst:185
msgid "Finally, complete the filling::"
msgstr ""

#: ../../library/turtle.rst:187
msgid "end_fill()"
msgstr ""

#: ../../library/turtle.rst:189
msgid ""
"(Note that filling only actually takes place when you give the "
"``end_fill()`` command.)"
