msgstr "修飾子"

#: ../../c-api/unicode.rst:444
msgid "Types"
msgstr "型"

#: ../../c-api/unicode.rst:446
msgid "``l``"
msgstr "``l``"

#: ../../c-api/unicode.rst:446
msgid ":c:expr:`long` or :c:expr:`unsigned long`"
msgstr ":c:expr:`long` または :c:expr:`unsigned long`"

#: ../../c-api/unicode.rst:448
msgid "``ll``"
msgstr "``ll``"

#: ../../c-api/unicode.rst:448
