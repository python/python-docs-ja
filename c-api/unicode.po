msgstr "符号付き C 整数の 10 進表現。"

#: ../../c-api/unicode.rst:478
msgid "``u``"
msgstr "``u``"

msgid "The decimal representation of an unsigned C integer."
msgstr "符号なし C 整数の 10 進表現。"

#: ../../c-api/unicode.rst:482
msgid "``o``"
msgstr "``o``"

