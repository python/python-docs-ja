msgid "``x - y``"
msgstr "``x - y``"

#: ../../builtins/stdtypes.rst:296
msgid "difference of *x* and *y*"
msgstr "*x* と *y* の差"

#: ../../builtins/stdtypes.rst:298
msgid "``x * y``"
msgstr "``x * y``"

#: ../../builtins/stdtypes.rst:298
msgid "product of *x* and *y*"
msgstr "*x* と *y* の積"

#: ../../builtins/stdtypes.rst:300
msgid "``x / y``"
msgstr "``x / y``"

#: ../../builtins/stdtypes.rst:300
msgid "quotient of *x* and *y*"
msgstr "*x* と *y* の商"

