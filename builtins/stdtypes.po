msgid "``x % y``"
msgstr "``x % y``"

#: ../../builtins/stdtypes.rst:305
msgid "remainder of ``x / y``"
msgstr "``x / y`` の剰余"

#: ../../builtins/stdtypes.rst:307
msgid "``-x``"
