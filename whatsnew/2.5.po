#: ../../whatsnew/2.5.rst:2117
msgid ""
"from _ast import PyCF_ONLY_AST\n"
"ast = compile(\"\"\"a=0\n"
"for i in range(10):\n"
"    a += i\n"
"\"\"\", \"<string>\", 'exec', PyCF_ONLY_AST)\n"
"\n"
"assignment = ast.body[0]\n"
"for_loop = ast.body[1]"
msgstr ""

#: ../../whatsnew/2.5.rst:2126
msgid ""
"No official documentation has been written for the AST code yet, but :pep:"
