#: ../../whatsnew/2.6.rst:2668
msgid "(Contributed by Alan McIntyre; :issue:`467924`.)"
msgstr "(Contributed by Alan McIntyre; :issue:`467924`.)"

#: ../../whatsnew/2.6.rst:2670
